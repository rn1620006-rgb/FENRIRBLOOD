# Never put secrets in frontend code. HTTPS must be used in production.
FENRIR_DB_PATH=./data/fenrirblood.sqlite3
FENRIR_SECURE_COOKIES=false # MUST be true behind HTTPS in production
FENRIR_PUBLIC_URL=http://localhost:8000
FENRIR_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FENRIR_SESSION_DAYS=7
FENRIR_SMTP_HOST=
FENRIR_SMTP_PORT=587
FENRIR_SMTP_USER=
FENRIR_SMTP_PASSWORD=
FENRIR_SMTP_SENDER=
